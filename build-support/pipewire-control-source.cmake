# Compile the selected fixed-source functions, without importing native Linux
# headers or pretending the scripted driver is a PipeWire stream.
set(_mfs_pw_source "${MFS_UPSTREAM_ROOT}/source/MaaLinuxControlUnit/Screencap/PipeWireScreencap.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_mfs_pw_source}")
file(READ "${_mfs_pw_source}" _mfs_pw_text)
string(REPLACE "\r\n" "\n" _mfs_pw_text "${_mfs_pw_text}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/pipewire-control-source.inc" "// Fixed-source bodies; LF normalization only.\n")
function(mfs_pw_extract begin end)
    string(FIND "${_mfs_pw_text}" "${begin}" _begin)
    if(_begin LESS 0)
        message(FATAL_ERROR "Missing PipeWire control begin: ${begin}")
    endif()
    string(SUBSTRING "${_mfs_pw_text}" ${_begin} -1 _tail)
    string(FIND "${_tail}" "${end}" _end)
    if(_end LESS_EQUAL 0)
        message(FATAL_ERROR "Missing PipeWire control end: ${end}")
    endif()
    string(SUBSTRING "${_tail}" 0 ${_end} _body)
    file(APPEND "${CMAKE_CURRENT_BINARY_DIR}/pipewire-control-source.inc" "${_body}\n")
endfunction()
mfs_pw_extract("template <typename Pred>\nstatic bool loop_wait_until" "// ---------------------------------------------------------------------------\n// SPA 格式表")
mfs_pw_extract("struct SpaFormatInfo" "// gamescope 的 Format pod")
mfs_pw_extract("bool PipeWireScreencap::connected() const" "// ===========================================================================\n// Screencap")
mfs_pw_extract("bool PipeWireScreencap::wait_for_frame_locked" "// ===========================================================================\n// PipeWire setup")
