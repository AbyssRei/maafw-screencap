# Compile fixed screenshot-manager function bodies, with explicit test-only
# platform/backend/clock boundaries. Generated files stay in the native build.
set(_mfs_manager_cpp "${MFS_UPSTREAM_ROOT}/source/MaaWin32ControlUnit/Manager/Win32ControlUnitMgr.cpp")
set(_mfs_manager_h "${MFS_UPSTREAM_ROOT}/source/MaaWin32ControlUnit/Manager/Win32ControlUnitMgr.h")
set(_mfs_time_h "${MFS_MAAUTILS_ROOT}/include/MaaUtils/Time.hpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_mfs_manager_cpp}" "${_mfs_manager_h}" "${_mfs_time_h}")
file(READ "${_mfs_manager_cpp}" _mfs_manager_source)
file(READ "${_mfs_manager_h}" _mfs_manager_header)
file(READ "${_mfs_time_h}" _mfs_time_source)
# Only newline normalization; no source statement is rewritten or hand copied.
string(REPLACE "\r\n" "\n" _mfs_manager_source "${_mfs_manager_source}")
string(REPLACE "\r\n" "\n" _mfs_manager_header "${_mfs_manager_header}")
string(REPLACE "\r\n" "\n" _mfs_time_source "${_mfs_time_source}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/manager-source.inc" "// Fixed-source function bodies; LF-normalized.\n")
function(mfs_manager_function begin end)
    string(FIND "${_mfs_manager_source}" "${begin}" _begin)
    if(_begin LESS 0)
        message(FATAL_ERROR "Missing fixed manager boundary: ${begin}")
    endif()
    string(SUBSTRING "${_mfs_manager_source}" ${_begin} -1 _tail)
    string(FIND "${_tail}" "${end}" _end)
    if(_end LESS_EQUAL 0)
        message(FATAL_ERROR "Missing fixed manager end: ${end}")
    endif()
    string(SUBSTRING "${_tail}" 0 ${_end} _body)
    file(APPEND "${CMAKE_CURRENT_BINARY_DIR}/manager-source.inc" "${_body}\n")
endfunction()
mfs_manager_function("Win32ControlUnitMgr::Win32ControlUnitMgr(" "bool Win32ControlUnitMgr::connect()")
mfs_manager_function("bool Win32ControlUnitMgr::connect()" "std::unordered_map<Win32ControlUnitMgr::ScreencapMethod")
mfs_manager_function("std::unordered_map<Win32ControlUnitMgr::ScreencapMethod" "bool Win32ControlUnitMgr::init_screencap()")
mfs_manager_function("bool Win32ControlUnitMgr::init_screencap()" "std::shared_ptr<InputBase> Win32ControlUnitMgr::make_input(")
mfs_manager_function("std::shared_ptr<ScreencapBase>\n    Win32ControlUnitMgr::speed_test(" "bool Win32ControlUnitMgr::connected()")
mfs_manager_function("bool Win32ControlUnitMgr::connected()" "bool Win32ControlUnitMgr::request_uuid(")
mfs_manager_function("bool Win32ControlUnitMgr::screencap(" "bool Win32ControlUnitMgr::click(")
mfs_manager_function("bool Win32ControlUnitMgr::inactive()" "json::object Win32ControlUnitMgr::get_info()")
string(REGEX MATCH "enum class ScreencapMethod[^}]+};" _enum "${_mfs_manager_header}")
if(NOT _enum)
    message(FATAL_ERROR "Missing original manager enum")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/manager-enum.inc" "${_enum}\n")
string(REGEX MATCH "template <typename duration_t = std::chrono::milliseconds>[^}]+}" _duration "${_mfs_time_source}")
if(NOT _duration)
    message(FATAL_ERROR "Missing original MaaUtils duration_since")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/manager-time.inc" "${_duration}\n")
