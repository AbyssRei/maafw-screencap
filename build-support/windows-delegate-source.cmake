# Selected capture-only outer delegation and the complete fixed loader class.
set(_delegate_cpp "${MFS_UPSTREAM_ROOT}/source/MaaGamepadControlUnit/Manager/GamepadControlUnitMgr.cpp")
set(_delegate_h "${MFS_UPSTREAM_ROOT}/source/MaaGamepadControlUnit/Manager/GamepadControlUnitMgr.h")
set(_holder_h "${MFS_MAAUTILS_ROOT}/include/MaaUtils/LibraryHolder.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_delegate_cpp}" "${_delegate_h}" "${_holder_h}")
file(READ "${_delegate_cpp}" _delegate_source)
file(READ "${_delegate_h}" _delegate_header)
string(REPLACE "\r\n" "\n" _delegate_source "${_delegate_source}")
set(_previous_field -1)
foreach(_field "HWND hwnd_ = nullptr;" "MaaWin32ScreencapMethod screencap_method_ = MaaWin32ScreencapMethod_None;" "std::unique_ptr<Win32ControlUnitLoader> win32_loader_;" "std::shared_ptr<ControlUnitAPI> win32_unit_;")
    string(FIND "${_delegate_header}" "${_field}" _at)
    if(_at LESS 0)
        message(FATAL_ERROR "Fixed capture delegate field drift: ${_field}")
    endif()
    if(_at LESS_EQUAL _previous_field)
        message(FATAL_ERROR "Fixed capture delegate member lifetime order drift")
    endif()
    set(_previous_field ${_at})
endforeach()
function(mfs_delegate_extract begin end output)
    string(FIND "${_delegate_source}" "${begin}" _begin)
    if(_begin LESS 0)
        message(FATAL_ERROR "Missing delegate source: ${begin}")
    endif()
    string(SUBSTRING "${_delegate_source}" ${_begin} -1 _tail)
    string(FIND "${_tail}" "${end}" _end)
    if(_end LESS_EQUAL 0)
        message(FATAL_ERROR "Missing delegate source end: ${end}")
    endif()
    string(SUBSTRING "${_tail}" 0 ${_end} _body)
    file(APPEND "${CMAKE_CURRENT_BINARY_DIR}/${output}" "${_body}\n")
endfunction()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/delegate-loader.inc" "// Exact fixed source, newline normalization only.\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/delegate-source.inc" "// Exact fixed source, newline normalization only.\n")
mfs_delegate_extract("class Win32ControlUnitLoader :" "GamepadControlUnitMgr::GamepadControlUnitMgr(" "delegate-loader.inc")
mfs_delegate_extract("bool GamepadControlUnitMgr::init_win32_unit()" "void GamepadControlUnitMgr::ensure_foreground()" "delegate-source.inc")
mfs_delegate_extract("bool GamepadControlUnitMgr::screencap(" "// get_features()" "delegate-source.inc")
mfs_delegate_extract("bool GamepadControlUnitMgr::inactive()" "json::object GamepadControlUnitMgr::get_info()" "delegate-source.inc")
string(REGEX MATCH "if \\(hwnd_ && screencap_method_ != MaaWin32ScreencapMethod_None\\)" _condition "${_delegate_source}")
if(NOT _condition)
    message(FATAL_ERROR "Original optional capture selection condition drift")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/delegate-condition.inc" "${_condition} { return true; } return false;\n")
# Preserve the actual LibraryHolder algorithm. Only its DLL/log/runtime
# boundary headers are explicitly overlaid by the scripted test fixture.
configure_file("${_holder_h}" "${CMAKE_CURRENT_BINARY_DIR}/original-LibraryHolder.h" COPYONLY)
