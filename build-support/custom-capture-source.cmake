# Exact fixed screenshot/connection bodies; unrelated custom input excluded.
set(_custom_root "${MFS_UPSTREAM_ROOT}/source/MaaCustomControlUnit/Manager")
file(READ "${_custom_root}/CustomControlUnitMgr.cpp" _custom_text)
file(READ "${_custom_root}/CustomControlUnitMgr.h" _custom_header)
file(READ "${MFS_UPSTREAM_ROOT}/source/Common/MaaBuffer.cpp" _raw_text)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_custom_root}/CustomControlUnitMgr.cpp" "${_custom_root}/CustomControlUnitMgr.h"
    "${MFS_UPSTREAM_ROOT}/source/Common/MaaBuffer.cpp")
string(REPLACE "\r\n" "\n" _custom_text "${_custom_text}")
string(REPLACE "\r\n" "\n" _raw_text "${_raw_text}")
foreach(_member "MaaCustomControllerCallbacks* controller_ = nullptr;" "void* controller_arg_ = nullptr;")
    string(FIND "${_custom_header}" "${_member}" _member_at)
    if(_member_at LESS 0)
        message(FATAL_ERROR "Fixed custom manager field drift: ${_member}")
    endif()
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/custom-source.inc" "// Exact fixed bodies; newline normalization only.\n")
function(mfs_custom_extract begin end)
    string(FIND "${_custom_text}" "${begin}" _begin)
    if(_begin LESS 0)
        message(FATAL_ERROR "Missing custom source: ${begin}")
    endif()
    string(SUBSTRING "${_custom_text}" ${_begin} -1 _tail)
    string(FIND "${_tail}" "${end}" _end)
    if(_end LESS_EQUAL 0)
        message(FATAL_ERROR "Missing custom source end: ${end}")
    endif()
    string(SUBSTRING "${_tail}" 0 ${_end} _body)
    file(APPEND "${CMAKE_CURRENT_BINARY_DIR}/custom-source.inc" "${_body}\n")
endfunction()
mfs_custom_extract("CustomControlUnitMgr::CustomControlUnitMgr(" "bool CustomControlUnitMgr::connect()")
mfs_custom_extract("bool CustomControlUnitMgr::connect()" "bool CustomControlUnitMgr::connected()")
mfs_custom_extract("bool CustomControlUnitMgr::connected()" "bool CustomControlUnitMgr::request_uuid(")
mfs_custom_extract("bool CustomControlUnitMgr::screencap(" "bool CustomControlUnitMgr::click(")
mfs_custom_extract("bool CustomControlUnitMgr::inactive()" "json::object CustomControlUnitMgr::get_info()")
string(FIND "${_raw_text}" "MaaBool MaaImageBufferSetRawData(" _raw_begin)
string(FIND "${_raw_text}" "MaaBool MaaImageBufferResize(" _raw_end)
if(_raw_begin LESS 0 OR _raw_end LESS_EQUAL _raw_begin)
    message(FATAL_ERROR "Missing original raw image setter")
endif()
math(EXPR _raw_length "${_raw_end}-${_raw_begin}")
string(SUBSTRING "${_raw_text}" ${_raw_begin} ${_raw_length} _raw_body)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/custom-raw-source.inc" "// Exact fixed raw setter.\n${_raw_body}")
