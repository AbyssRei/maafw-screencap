# Explicit legacy configuration/API oracle only. All source copies/extractions
# remain in the external native build directory, without editing fixed inputs.
set(_mfs_config_root "${MFS_UPSTREAM_ROOT}/source/MaaLinuxControlUnit")
set(_mfs_config_overlay "${CMAKE_CURRENT_BINARY_DIR}/config-overlay")
foreach(_relative "Base/Config.h" "Base/UnitBase.h" "Manager/LinuxControlUnitMgr.h")
    configure_file("${_mfs_config_root}/${_relative}" "${_mfs_config_overlay}/${_relative}" COPYONLY)
endforeach()
set(_mfs_manager_file "${_mfs_config_root}/Manager/LinuxControlUnitMgr.cpp")
set(_mfs_api_file "${_mfs_config_root}/API/LinuxControlUnitAPI.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_mfs_manager_file}" "${_mfs_api_file}")
file(READ "${_mfs_manager_file}" _mfs_config_manager_text)
file(READ "${_mfs_api_file}" _mfs_config_api_text)
string(REPLACE "\r\n" "\n" _mfs_config_manager_text "${_mfs_config_manager_text}")
string(REPLACE "\r\n" "\n" _mfs_config_api_text "${_mfs_config_api_text}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/linux-config-manager.inc" "// Exact original manager bodies; LF normalization only.\n")
function(mfs_config_extract begin end)
    string(FIND "${_mfs_config_manager_text}" "${begin}" _begin)
    if(_begin LESS 0)
        message(FATAL_ERROR "Missing fixed config manager boundary: ${begin}")
    endif()
    string(SUBSTRING "${_mfs_config_manager_text}" ${_begin} -1 _tail)
    string(FIND "${_tail}" "${end}" _end)
    if(_end LESS_EQUAL 0)
        message(FATAL_ERROR "Missing fixed config manager end: ${end}")
    endif()
    string(SUBSTRING "${_tail}" 0 ${_end} _body)
    file(APPEND "${CMAKE_CURRENT_BINARY_DIR}/linux-config-manager.inc" "${_body}\n")
endfunction()
mfs_config_extract("LinuxControlUnitMgr::LinuxControlUnitMgr(" "bool LinuxControlUnitMgr::connect()")
mfs_config_extract("bool LinuxControlUnitMgr::connected()" "bool LinuxControlUnitMgr::request_uuid(")
mfs_config_extract("bool LinuxControlUnitMgr::request_uuid(" "MaaControllerFeature LinuxControlUnitMgr::get_features()")
mfs_config_extract("MaaControllerFeature LinuxControlUnitMgr::get_features()" "bool LinuxControlUnitMgr::start_app(")
mfs_config_extract("bool LinuxControlUnitMgr::screencap(" "bool LinuxControlUnitMgr::click(")
mfs_config_extract("bool LinuxControlUnitMgr::inactive()" "json::object LinuxControlUnitMgr::get_info()")
mfs_config_extract("json::object LinuxControlUnitMgr::get_info()" "bool LinuxControlUnitMgr::create_screencap()")
string(FIND "${_mfs_config_api_text}" "const char* MaaLinuxControlUnitGetVersion()" _api_begin)
if(_api_begin LESS 0)
    message(FATAL_ERROR "Missing fixed Linux configuration API functions")
endif()
string(SUBSTRING "${_mfs_config_api_text}" ${_api_begin} -1 _api_body)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/linux-config-api.inc" "// Exact complete fixed API functions, excluding includes only.\n${_api_body}")
