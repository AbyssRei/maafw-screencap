# Fixed manager screenshot functions, newline normalization only.
set(_mfs_linux_manager "${MFS_UPSTREAM_ROOT}/source/MaaLinuxControlUnit/Manager/LinuxControlUnitMgr.cpp")
if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_mfs_linux_manager}")
endif()
file(READ "${_mfs_linux_manager}" _mfs_linux_text)
set(_mfs_config "${MFS_UPSTREAM_ROOT}/source/MaaLinuxControlUnit/Base/Config.h")
file(READ "${_mfs_config}" _mfs_config_text)
string(REPLACE "\r\n" "\n" _mfs_config_text "${_mfs_config_text}")
string(FIND "${_mfs_config_text}" "struct LinuxControlUnitConfig\n" _config_begin)
string(FIND "${_mfs_config_text}" "    MEO_JSONIZATION(" _config_end)
if(_config_begin LESS 0 OR _config_end LESS_EQUAL _config_begin)
    message(FATAL_ERROR "Missing fixed Linux configuration member boundaries")
endif()
math(EXPR _config_length "${_config_end}-${_config_begin}")
string(SUBSTRING "${_mfs_config_text}" ${_config_begin} ${_config_length} _config_body)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/linux-manager-config.inc"
    "// Exact configuration members; serialization macro intentionally excluded.\n${_config_body}};\n")
set(_mfs_linux_header "${MFS_UPSTREAM_ROOT}/source/MaaLinuxControlUnit/Manager/LinuxControlUnitMgr.h")
file(READ "${_mfs_linux_header}" _mfs_linux_declarations)
if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_mfs_linux_header}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_mfs_config}")
endif()
foreach(_field "const LinuxControlUnitConfig config_;" "bool connected_ = false;"
    "std::shared_ptr<InputBase> input_ = nullptr;"
    "std::shared_ptr<ScreencapBase> screencap_ = nullptr;"
    "std::shared_ptr<WaylandClient> wl_client_ = nullptr;")
    string(FIND "${_mfs_linux_declarations}" "${_field}" _position)
    if(_position LESS 0)
        message(FATAL_ERROR "Fixed Linux manager declaration drift: ${_field}")
    endif()
endforeach()
string(REPLACE "\r\n" "\n" _mfs_linux_text "${_mfs_linux_text}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/linux-manager-source.inc" "// Exact fixed bodies; LF normalization only.\n")
function(mfs_linux_manager_extract begin end)
    string(FIND "${_mfs_linux_text}" "${begin}" _begin)
    if(_begin LESS 0)
        message(FATAL_ERROR "Missing Linux manager boundary: ${begin}")
    endif()
    string(SUBSTRING "${_mfs_linux_text}" ${_begin} -1 _tail)
    string(FIND "${_tail}" "${end}" _end)
    if(_end LESS_EQUAL 0)
        message(FATAL_ERROR "Missing Linux manager end: ${end}")
    endif()
    string(SUBSTRING "${_tail}" 0 ${_end} _body)
    if(ARGC EQUAL 3)
        file(APPEND "${ARGV2}" "${_body}\n")
    else()
        file(APPEND "${CMAKE_CURRENT_BINARY_DIR}/linux-manager-source.inc" "${_body}\n")
    endif()
endfunction()
mfs_linux_manager_extract("LinuxControlUnitMgr::LinuxControlUnitMgr(" "bool LinuxControlUnitMgr::connect()")
mfs_linux_manager_extract("bool LinuxControlUnitMgr::connect()" "bool LinuxControlUnitMgr::connected()")
mfs_linux_manager_extract("bool LinuxControlUnitMgr::connected()" "bool LinuxControlUnitMgr::request_uuid(")
mfs_linux_manager_extract("bool LinuxControlUnitMgr::request_uuid(" "MaaControllerFeature LinuxControlUnitMgr::get_features()")
mfs_linux_manager_extract("bool LinuxControlUnitMgr::screencap(" "bool LinuxControlUnitMgr::click(")
mfs_linux_manager_extract("bool LinuxControlUnitMgr::inactive()" "json::object LinuxControlUnitMgr::get_info()")
mfs_linux_manager_extract("bool LinuxControlUnitMgr::create_screencap()" "bool LinuxControlUnitMgr::create_input()")
mfs_linux_manager_extract("bool LinuxControlUnitMgr::create_input()" "bool LinuxControlUnitMgr::create_wl_client()")
mfs_linux_manager_extract("bool LinuxControlUnitMgr::create_wl_client()" "int LinuxControlUnitMgr::translate_key(")
# Used by the host-boundary model only; native screenshot-only contexts retain
# their original declaration surface and include the preceding bodies alone.
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/linux-manager-features.inc" "// Exact fixed feature query; LF normalization only.\n")
mfs_linux_manager_extract("MaaControllerFeature LinuxControlUnitMgr::get_features()" "bool LinuxControlUnitMgr::start_app(" "${CMAKE_CURRENT_BINARY_DIR}/linux-manager-features.inc")
