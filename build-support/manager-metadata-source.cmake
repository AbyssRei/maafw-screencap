# Exact fixed get_info bodies and the contiguous metadata member declarations.
# The explicit model does not construct/connect the real native manager or input.
function(mfs_metadata_extract kind directory class first_member)
    set(_root "${MFS_UPSTREAM_ROOT}/source/${directory}/Manager")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_root}/${class}.cpp" "${_root}/${class}.h")
    file(READ "${_root}/${class}.cpp" _source)
    file(READ "${_root}/${class}.h" _header)
    string(REPLACE "\r\n" "\n" _source "${_source}")
    string(REPLACE "\r\n" "\n" _header "${_header}")
    string(FIND "${_source}" "json::object ${class}::get_info() const" _begin)
    if(_begin LESS 0)
        message(FATAL_ERROR "Missing fixed metadata body: ${class}")
    endif()
    string(SUBSTRING "${_source}" ${_begin} -1 _tail)
    string(FIND "${_tail}" "MAA_CTRL_UNIT_NS_END" _end)
    if(_end LESS_EQUAL 0)
        message(FATAL_ERROR "Missing fixed metadata end: ${class}")
    endif()
    string(SUBSTRING "${_tail}" 0 ${_end} _body)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${kind}-info-source.inc" "// Exact fixed body; newline normalization only.\n${_body}")
    string(FIND "${_header}" "    ${first_member}" _begin)
    string(FIND "${_header}" "    bool connected_ = false;" _end)
    if(_begin LESS 0 OR _end LESS_EQUAL _begin)
        message(FATAL_ERROR "Missing fixed metadata member range: ${class}")
    endif()
    math(EXPR _length "${_end}-${_begin}")
    string(SUBSTRING "${_header}" ${_begin} ${_length} _members)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${kind}-info-members.inc" "// Exact fixed metadata members.\n${_members}")
endfunction()
mfs_metadata_extract(win32 MaaWin32ControlUnit Win32ControlUnitMgr "HWND hwnd_")
mfs_metadata_extract(macos MaaMacOSControlUnit MacOSControlUnitMgr "uint32_t window_id_")
